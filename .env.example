# Configura tus propios valores. Este archivo no contiene credenciales reales.
DATABASE_URL="postgresql://pagina_user:CONTRASENA@127.0.0.1:5433/pagina_principal_db"
# Solo para PostgreSQL local en Docker. Usa la misma contraseña en DATABASE_URL.
POSTGRES_DB=pagina_principal_db
POSTGRES_USER=pagina_user
POSTGRES_PASSWORD=""
POSTGRES_PORT=5433
JWT_SECRET=""
FRONTEND_URL="http://localhost:5173"
PORT=4000
SWAGGER_ENABLED=true

# Solo para npm run seed; no se utilizan para iniciar sesión directamente.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
