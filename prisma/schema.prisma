// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model ContactMessage {
  id          Int             @id @default(autoincrement())
  name        String
  email       String          @default("")
  projectType String
  budget      String
  message     String          @db.Text
  isRead      Boolean         @default(false)
  status      ContactStatus   @default(NEW)
  priority    ContactPriority @default(NORMAL)
  adminNotes  String?         @db.Text
  contactedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @default(now()) @updatedAt

  agentSummary         String? @db.Text
  agentSuggestedAction String? @db.Text
  agentSuggestedReply  String? @db.Text
  agentScore           Int?
  agentTags            Json?

  quotePlanSlug        String?
  quotePlanName        String?
  quoteMinPrice        Int?
  quoteMaxPrice        Int?
  quoteSuggestedBudget String?
  quoteComplexity      String?
  quoteEstimatedTime   String?
  quoteExtras          Json?
  quoteSnapshot        Json?

  adminPublicReply String?   @db.Text
  adminReplyAt     DateTime?

  technicalSummary            String?   @db.Text
  technicalDifficulty         String?
  technicalEstimatedTime      String?
  technicalSuggestedModules   Json?
  technicalSuggestedTables    Json?
  technicalSuggestedEndpoints Json?
  technicalSuggestedScreens   Json?
  technicalChecklist          Json?
  technicalNotes              String?   @db.Text
  technicalAnalysisAt         DateTime?

  comments ContactMessageComment[]
}

model ContactMessageComment {
  id               Int       @id @default(autoincrement())
  contactMessageId Int
  senderId         Int?
  senderName       String
  senderEmail      String
  senderRole       Role
  message          String    @db.Text
  readAt           DateTime?
  createdAt        DateTime  @default(now())

  contactMessage ContactMessage @relation(fields: [contactMessageId], references: [id], onDelete: Cascade)

  @@index([contactMessageId])
  @@index([senderRole])
  @@index([createdAt])
}

enum ContactStatus {
  NEW
  REVIEWING
  CONTACTED
  CLOSED
}

enum ContactPriority {
  LOW
  NORMAL
  HIGH
}

enum Role {
  ADMIN
  USER
}

model User {
  id                  Int      @id @default(autoincrement())
  name                String
  email               String   @unique
  password            String
  role                Role     @default(USER)
  adminProfileId      Int?
  projectRequestLimit Int      @default(3)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  adminProfile AdminProfile? @relation(fields: [adminProfileId], references: [id], onDelete: Restrict)

  @@index([adminProfileId])
}

/// Perfil configurable del personal administrativo (p. ej. vendedor o gerente).
/// El rol ADMIN/USER existente sigue distinguiendo personal de clientes.
model AdminProfile {
  id           Int      @id @default(autoincrement())
  name         String   @unique
  slug         String   @unique
  description  String?
  isSystem     Boolean  @default(false)
  isSuperAdmin Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users       User[]
  permissions AdminProfilePermission[]
}

/// Catálogo estable de permisos comprobados por el backend.
model Permission {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  name        String
  module      String
  description String?

  profiles AdminProfilePermission[]
}

/// Relación muchos a muchos entre perfiles administrativos y permisos.
model AdminProfilePermission {
  profileId    Int
  permissionId Int
  profile      AdminProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  permission   Permission   @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([profileId, permissionId])
  @@index([permissionId])
}

model Project {
  id           Int      @id @default(autoincrement())
  title        String
  type         String
  description  String   @db.Text
  image        String?
  status       String
  technologies Json
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Service {
  id          Int      @id @default(autoincrement())
  title       String
  description String   @db.Text
  icon        String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum ContactOptionType {
  PROJECT_TYPE
  BUDGET
}

model ContactOption {
  id        Int               @id @default(autoincrement())
  type      ContactOptionType
  label     String
  value     String
  sortOrder Int               @default(0)
  isActive  Boolean           @default(true)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@unique([type, value])
}

model Plan {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  name        String
  subtitle    String
  description String   @db.Text
  idealFor    String   @db.Text
  features    Json
  cta         String
  highlight   Boolean  @default(false)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model LandingSection {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  label     String
  href      String
  sortOrder Int      @default(0)
  isVisible Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum AuditLogAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  CHANGE_PASSWORD
  MARK_READ
  GENERATE_ANALYSIS
  STATUS_CHANGE
  ROLE_CHANGE
}

model AuditLog {
  id          Int            @id @default(autoincrement())
  action      AuditLogAction
  module      String
  description String         @db.Text

  actorId    Int?
  actorName  String?
  actorEmail String?
  actorRole  Role?

  targetId   Int?
  targetType String?

  metadata  Json?
  createdAt DateTime @default(now())

  @@index([action])
  @@index([module])
  @@index([actorId])
  @@index([targetId])
  @@index([createdAt])
}
